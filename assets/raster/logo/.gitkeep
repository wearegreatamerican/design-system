  ga-logo-sand-400.png   ga-logo-sand-800.png   ga-logo-sand-1600.png
  ga-logo-white-400.png  ga-logo-white-800.png  ga-logo-white-1600.png
  ga-logo-black-400.png  ga-logo-black-800.png  ga-logo-black-1600.png

